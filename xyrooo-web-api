    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-body);
            color: var(--text-primary);
            line-height: 1.5;
            position: relative;
        }

        /* Background tema dari logo */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://files.catbox.moe/kya6b5.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            opacity: 0.08;
            pointer-events: none;
            z-index: -1;
        }

        /* Tema Terang (Light) */
        :root {
            --bg-body: #f8fafc;
            --bg-card: rgba(255, 255, 255, 0.92);
            --text-primary: #0f172a;
            --text-secondary: #334155;
            --border: rgba(203, 213, 225, 0.6);
            --primary: #7c3aed;
            --primary-dark: #6d28d9;
            --primary-light: #ede9fe;
            --danger: #ef4444;
            --success: #10b981;
            --warning: #f59e0b;
            --glass: rgba(255,255,255,0.75);
            --shadow: 0 20px 35px -12px rgba(0,0,0,0.1);
            --card-blur: blur(2px);
        }

        body.dark {
            --bg-body: #0b1120;
            --bg-card: rgba(15, 23, 42, 0.94);
            --text-primary: #f1f5f9;
            --text-secondary: #cbd5e1;
            --border: rgba(51, 65, 85, 0.7);
            --primary: #a78bfa;
            --primary-dark: #8b5cf6;
            --primary-light: #2e1065;
            --glass: rgba(15,23,42,0.85);
            --shadow: 0 20px 35px -12px rgba(0,0,0,0.4);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1rem 1.8rem;
        }

        /* Navbar */
        .navbar {
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow);
        }

        .nav-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-img {
            width: 44px;
            height: 44px;
            border-radius: 16px;
            object-fit: cover;
            border: 2px solid var(--primary);
        }

        .brand {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.6rem;
            background: linear-gradient(135deg, var(--primary), #c084fc, #a855f7);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .nav-links {
            display: flex;
            gap: 1.2rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-secondary);
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 40px;
            transition: 0.2s;
        }

        .nav-links a:hover, .nav-links a.active {
            background: var(--primary-light);
            color: var(--primary);
        }

        .theme-toggle {
            background: var(--primary-light);
            border: none;
            padding: 8px 16px;
            border-radius: 40px;
            cursor: pointer;
            color: var(--primary);
            font-weight: 600;
            display: flex;
            gap: 8px;
            align-items: center;
        }

        /* Card */
        .card {
            background: var(--bg-card);
            backdrop-filter: blur(8px);
            border-radius: 32px;
            padding: 1.8rem;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            margin-bottom: 1.8rem;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.8rem;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        /* Button */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: 40px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            font-family: inherit;
            background: var(--primary);
            color: white;
            transition: 0.2s;
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--primary);
            color: var(--primary);
        }

        .btn-danger {
            background: var(--danger);
        }

        .btn-sm {
            padding: 6px 16px;
            font-size: 0.85rem;
        }

        .btn-block {
            width: 100%;
            justify-content: center;
        }

        button:active { transform: scale(0.96); }

        /* Badge & stat */
        .stat-badge {
            background: var(--primary-light);
            padding: 6px 16px;
            border-radius: 40px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }

        /* Endpoint styling */
        .endpoint-card {
            background: var(--bg-body);
            border-radius: 24px;
            padding: 1.2rem;
            border-left: 4px solid var(--primary);
            margin-bottom: 1rem;
        }

        .method {
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 30px;
            display: inline-block;
            font-size: 0.75rem;
        }
        .method-get { background: #10b98120; color: #10b981; }
        .method-post { background: #3b82f620; color: #3b82f6; }
        .url-text {
            font-family: monospace;
            background: var(--border);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            word-break: break-all;
        }

        input, textarea, select {
            background: var(--bg-body);
            border: 1px solid var(--border);
            padding: 12px 16px;
            border-radius: 28px;
            width: 100%;
            font-family: inherit;
            color: var(--text-primary);
        }

        .api-key-box {
            background: var(--bg-body);
            padding: 12px;
            border-radius: 24px;
            font-family: monospace;
            word-break: break-all;
            border: 1px dashed var(--primary);
        }

        footer {
            text-align: center;
            padding: 2rem;
            border-top: 1px solid var(--border);
            margin-top: 2rem;
            color: var(--text-secondary);
            background: var(--bg-card);
            backdrop-filter: blur(8px);
        }

        .hidden { display: none; }

        @media (max-width: 700px) {
            .container { padding: 1rem; }
            .nav-inner { flex-direction: column; }
        }

        /* Alert real */
        .alert-real {
            background: var(--success);
            color: white;
            padding: 8px 16px;
            border-radius: 40px;
            font-size: 0.75rem;
        }
    </style>
</head>
